# Configure the engine itself for a different Apple platform.
#
# CMAKE_SYSTEM_PROCESSOR is empty when the target is iOS, so list(FIND) is a
# required argument short and configuration aborts. Patch 0010 fixed the same
# expression in deps/CMakeLists.txt; this is the copy in the engine's own root,
# which only becomes reachable once the dependencies build.
#
# Deletable when upstream stops deriving cross-compilation from a comparison of
# architectures, which cannot see a change of platform.

diff --git a/CMakeLists.txt b/CMakeLists.txt
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -150,7 +150,18 @@
     endif ()
     set(CMAKE_FIND_FRAMEWORK LAST)
     set(CMAKE_FIND_APPBUNDLE LAST)
-    list(FIND CMAKE_OSX_ARCHITECTURES ${CMAKE_SYSTEM_PROCESSOR} _arch_idx)
+    # The same reasoning as in deps/CMakeLists.txt: CMAKE_SYSTEM_PROCESSOR is empty
+    # when the target is iOS, which leaves list(FIND) a required argument short and
+    # aborts configuration. It is also the wrong question, since it compares
+    # architectures — building for iOS on an arm64 Mac looks native by that measure
+    # even though the sysroot is a different platform entirely.
+    set(_arch_idx -1)
+    if (CMAKE_SYSTEM_PROCESSOR)
+        list(FIND CMAKE_OSX_ARCHITECTURES "${CMAKE_SYSTEM_PROCESSOR}" _arch_idx)
+    endif ()
+    if (NOT CMAKE_SYSTEM_NAME STREQUAL CMAKE_HOST_SYSTEM_NAME)
+        set(_arch_idx -1)
+    endif ()
     if (CMAKE_OSX_ARCHITECTURES AND _arch_idx LESS 0)
         set(IS_CROSS_COMPILE TRUE)
     endif ()
