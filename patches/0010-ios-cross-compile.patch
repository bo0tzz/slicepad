# Let the dependency superbuild target another Apple platform.
#
# Building for iOS leaves CMAKE_SYSTEM_PROCESSOR empty, which drops an argument
# from a list(FIND) and from OpenSSL's STREQUAL comparisons — both hard errors
# before anything compiles. The cross-compile detection also asks the wrong
# question: it compares architectures, so iOS on an arm64 Mac looks native.
#
# OpenSSL additionally needs its own iOS target: Apple cross-compiles through
# clang and -arch rather than a toolchain prefix, so the Linux branch asks for a
# --cross-compile-prefix that does not exist.
diff --git a/deps/CMakeLists.txt b/deps/CMakeLists.txt
--- a/deps/CMakeLists.txt
+++ b/deps/CMakeLists.txt
@@ -131,7 +131,17 @@
     endif ()
     set(CMAKE_FIND_FRAMEWORK LAST)
     set(CMAKE_FIND_APPBUNDLE LAST)
-    list(FIND CMAKE_OSX_ARCHITECTURES ${CMAKE_SYSTEM_PROCESSOR} _arch_idx)
+    # Targeting iOS leaves CMAKE_SYSTEM_PROCESSOR empty, which drops an argument
+    # from the list(FIND) below and makes it a hard error. It is also the wrong
+    # question: this compares architectures, so building for iOS on an arm64 Mac
+    # would look native even though the sysroot differs entirely.
+    set(_arch_idx -1)
+    if (CMAKE_SYSTEM_PROCESSOR)
+        list(FIND CMAKE_OSX_ARCHITECTURES "${CMAKE_SYSTEM_PROCESSOR}" _arch_idx)
+    endif ()
+    if (NOT CMAKE_SYSTEM_NAME STREQUAL CMAKE_HOST_SYSTEM_NAME)
+        set(_arch_idx -1)  # a different Apple platform is always a cross build
+    endif ()
     message(STATUS "prusaslicer_add_cmake_project for Apple")
     if (CMAKE_OSX_ARCHITECTURES AND _arch_idx LESS 0)
         message(STATUS "prusaslicer_add_cmake_project for Apple crosscompiling")
diff --git a/deps/OpenSSL/OpenSSL.cmake b/deps/OpenSSL/OpenSSL.cmake
--- a/deps/OpenSSL/OpenSSL.cmake
+++ b/deps/OpenSSL/OpenSSL.cmake
@@ -22,7 +22,21 @@
     set(_make_cmd nmake)
     set(_install_cmd nmake install_sw )
 else()
-    if(APPLE)
+    if(APPLE AND CMAKE_SYSTEM_NAME STREQUAL "iOS")
+        # -mmacosx-version-min is meaningless here, and the ios64-cross target
+        # builds its sysroot out of CROSS_TOP and CROSS_SDK — unset, so it emits
+        # "-isysroot /SDKs/" and every file fails to find a header. Naming the
+        # sysroot outright is both simpler and independent of Xcode's layout.
+        #
+        # The simulator carries a different Mach-O platform id, so it needs its own
+        # minimum-version flag: built with the device one, nothing will link.
+        if (CMAKE_OSX_SYSROOT MATCHES "[Ss]imulator")
+            set(_openssl_min_version -mios-simulator-version-min=${CMAKE_OSX_DEPLOYMENT_TARGET})
+        else ()
+            set(_openssl_min_version -mios-version-min=${CMAKE_OSX_DEPLOYMENT_TARGET})
+        endif ()
+        set(_conf_cmd ./Configure -isysroot ${CMAKE_OSX_SYSROOT} ${_openssl_min_version})
+    elseif(APPLE)
         set(_conf_cmd export MACOSX_DEPLOYMENT_TARGET=${CMAKE_OSX_DEPLOYMENT_TARGET} && ./Configure -mmacosx-version-min=${CMAKE_OSX_DEPLOYMENT_TARGET})
     else()
         set(_conf_cmd env "CC=${CMAKE_C_COMPILER}" "LDFLAGS=${CMAKE_EXE_LINKER_FLAGS}" "./config")
@@ -30,12 +44,25 @@
     set(_cross_comp_prefix_line "")
     set(_make_cmd make -j${NPROC})
     set(_install_cmd make -j${NPROC} install_sw)
-    if (CMAKE_CROSSCOMPILING)
+    if (CMAKE_SYSTEM_NAME STREQUAL "iOS")
+        # Apple cross-compiles through clang and -arch rather than a toolchain
+        # prefix, and OpenSSL has a target of its own for this. Without the branch
+        # an iOS build falls into the Linux one below and asks for a prefix that
+        # does not exist.
+        # OpenSSL keeps a separate target for the simulator, which differs from
+        # the device one in the compiler it drives.
+        if (CMAKE_OSX_SYSROOT MATCHES "[Ss]imulator")
+            set(_cross_arch "iossimulator-xcrun")
+        else ()
+            set(_cross_arch "ios64-cross")
+        endif ()
+        set(_cross_comp_prefix_line "")
+    elseif (CMAKE_CROSSCOMPILING)
         set(_cross_comp_prefix_line "--cross-compile-prefix=${TOOLCHAIN_PREFIX}-")
 
-        if (${CMAKE_SYSTEM_PROCESSOR} STREQUAL "aarch64" OR ${CMAKE_SYSTEM_PROCESSOR} STREQUAL "arm64")
+        if ("${CMAKE_SYSTEM_PROCESSOR}" STREQUAL "aarch64" OR "${CMAKE_SYSTEM_PROCESSOR}" STREQUAL "arm64")
             set(_cross_arch "linux-aarch64")
-        elseif (${CMAKE_SYSTEM_PROCESSOR} STREQUAL "armhf") # For raspbian
+        elseif ("${CMAKE_SYSTEM_PROCESSOR}" STREQUAL "armhf") # For raspbian
             # TODO: verify
             set(_cross_arch "linux-armv4")
         endif ()
