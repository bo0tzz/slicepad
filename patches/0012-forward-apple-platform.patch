# Tell the dependency sub-builds which platform they are targeting.
#
# The superbuild forwards compilers, toolchain file and CMAKE_OSX_ARCHITECTURES
# to each ExternalProject, but not the system name, sysroot or deployment
# target. Architecture alone does not describe an Apple target, so every CMake
# dependency built for macOS while the top level believed it was building for
# iOS — and nothing failed to say so.

diff --git a/deps/CMakeLists.txt b/deps/CMakeLists.txt
index 1858ee29..3f30a391 100644
--- a/deps/CMakeLists.txt
+++ b/deps/CMakeLists.txt
@@ -149,6 +149,15 @@ if (APPLE)
         set(CMAKE_CXX_COMPILER_ID "Clang")
         string(REPLACE ";" "$<SEMICOLON>" CMAKE_OSX_ARCHS "${CMAKE_OSX_ARCHITECTURES}")
         set(_cmake_osx_arch -DCMAKE_OSX_ARCHITECTURES:STRING=${CMAKE_OSX_ARCHS})
+        # Architecture alone does not describe the target. Without the platform
+        # and its sysroot, every CMake dependency below builds for macOS while
+        # believing it is doing what was asked.
+        if (NOT CMAKE_SYSTEM_NAME STREQUAL CMAKE_HOST_SYSTEM_NAME)
+            list(APPEND _cmake_osx_arch
+                -DCMAKE_SYSTEM_NAME:STRING=${CMAKE_SYSTEM_NAME}
+                -DCMAKE_OSX_SYSROOT:STRING=${CMAKE_OSX_SYSROOT}
+                -DCMAKE_OSX_DEPLOYMENT_TARGET:STRING=${CMAKE_OSX_DEPLOYMENT_TARGET})
+        endif ()
         set(_cmake_args_osx_arch CMAKE_ARGS -DCMAKE_OSX_ARCHITECTURES:STRING=${CMAKE_OSX_ARCHS})
         message(STATUS "Detect Cross-compilation. Will build for target ${CMAKE_OSX_ARCHS}" )
     endif ()
