# Allow a headless configure of the top-level project.
#
# With SLIC3R_GUI=OFF the top level still requires CURL, OpenGL, glfw3 and
# Freetype, none of which libslic3r links, and hard-fails when OpenVDB is
# missing even though libslic3r already guards on the imported target.
# SLIC3R_WITH_OPENVDB makes that lookup match libslic3r's own optionality.

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 8dcd4cf0..635b2016 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -630,12 +630,20 @@ find_package(TBB REQUIRED)
 # add_definitions(-DTBB_USE_CAPTURED_EXCEPTION=0)
 
 find_package(OpenSSL REQUIRED)
-find_package(CURL REQUIRED)
-find_package(Freetype REQUIRED)
-
 
+# CURL is reached only through src/slic3r's network code, and Freetype only
+# through OCCT's text support. Neither is needed by libslic3r on its own. The
+# libcurl INTERFACE target is still declared unconditionally, since later blocks
+# add to it and an INTERFACE target with no consumers costs nothing.
 add_library(libcurl INTERFACE)
-target_link_libraries(libcurl INTERFACE CURL::libcurl)
+if (SLIC3R_GUI)
+    find_package(CURL REQUIRED)
+    target_link_libraries(libcurl INTERFACE CURL::libcurl)
+endif ()
+
+if (SLIC3R_GUI OR SLIC3R_WITH_OCCT)
+    find_package(Freetype REQUIRED)
+endif ()
 
 find_package(ZLIB REQUIRED)
 target_link_libraries(libcurl INTERFACE ZLIB::ZLIB)
@@ -688,14 +696,16 @@ endif ()
 
 find_package(PNG REQUIRED)
 
-set(OpenGL_GL_PREFERENCE "LEGACY")
-find_package(OpenGL REQUIRED)
+if (SLIC3R_GUI)
+    set(OpenGL_GL_PREFERENCE "LEGACY")
+    find_package(OpenGL REQUIRED)
 
-if(APPLE AND CMAKE_VERSION VERSION_GREATER_EQUAL "4.0")
-    set(OPENGL_LIBRARIES "-framework OpenGL" CACHE STRING "OpenGL framework" FORCE)
-endif()
+    if(APPLE AND CMAKE_VERSION VERSION_GREATER_EQUAL "4.0")
+        set(OPENGL_LIBRARIES "-framework OpenGL" CACHE STRING "OpenGL framework" FORCE)
+    endif()
 
-find_package(glfw3 REQUIRED)
+    find_package(glfw3 REQUIRED)
+endif ()
 
 # Find the Cereal serialization library
 find_package(cereal REQUIRED)
@@ -751,19 +761,26 @@ endforeach()
 find_package(NLopt 1.4 REQUIRED)
 
 
-if(SLIC3R_STATIC)
-    set(OPENVDB_USE_STATIC_LIBS ON)
-    set(USE_BLOSC TRUE)
-endif ()
+# libslic3r already treats OpenVDB as optional (it guards on the imported
+# target), so make the top-level lookup match rather than hard-failing. Only
+# mesh hollowing needs it.
+option(SLIC3R_WITH_OPENVDB "Enable OpenVDB-backed hollowing" ON)
 
-find_package(OpenVDB 5.0 COMPONENTS openvdb)
-if(OpenVDB_FOUND)
-    slic3r_remap_configs(IlmBase::Half RelWithDebInfo Release)
-    slic3r_remap_configs(Blosc::blosc RelWithDebInfo Release)
-else ()
-    message(FATAL_ERROR "OpenVDB could not be found with the bundled find module. "
-                   "You can try to specify the find module location of your "
-                   "OpenVDB installation with the OPENVDB_FIND_MODULE_PATH cache variable.")
+if (SLIC3R_WITH_OPENVDB)
+    if(SLIC3R_STATIC)
+        set(OPENVDB_USE_STATIC_LIBS ON)
+        set(USE_BLOSC TRUE)
+    endif ()
+
+    find_package(OpenVDB 5.0 COMPONENTS openvdb)
+    if(OpenVDB_FOUND)
+        slic3r_remap_configs(IlmBase::Half RelWithDebInfo Release)
+        slic3r_remap_configs(Blosc::blosc RelWithDebInfo Release)
+    else ()
+        message(FATAL_ERROR "OpenVDB could not be found with the bundled find module. "
+                       "You can try to specify the find module location of your "
+                       "OpenVDB installation with the OPENVDB_FIND_MODULE_PATH cache variable.")
+    endif ()
 endif ()
 
 find_path(SPNAV_INCLUDE_DIR spnav.h)
