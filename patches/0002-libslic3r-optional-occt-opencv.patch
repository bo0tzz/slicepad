# Make OCCT and OpenCV optional in libslic3r.
#
# OCCT (26 TK* libraries) backs STEP/SVG import and text embossing; OpenCV
# backs OBJ colour quantisation. Neither is reachable from mesh slicing, and
# both are among the hardest dependencies to cross-compile.
#
# Guarded sources are wrapped rather than removed from the source list, so if
# upstream adds an OCCT-using source it fails loudly on the next engine bump
# instead of silently dropping a feature.

diff --git a/src/libslic3r/CMakeLists.txt b/src/libslic3r/CMakeLists.txt
index 9b67d7ab..4f2ba3b3 100644
--- a/src/libslic3r/CMakeLists.txt
+++ b/src/libslic3r/CMakeLists.txt
@@ -20,6 +20,14 @@ endif()
 
 option(BUILD_SHARED_LIBS "Build shared libs" OFF)
 
+# OCCT provides STEP and SVG import plus text embossing; OpenCV provides OBJ
+# colour quantisation. Both are large and neither is reachable from plain mesh
+# slicing, so allow a build without them. The guarded sources compile to empty
+# translation units rather than being dropped from the list, so that a new
+# OCCT-using source upstream fails loudly at the next engine bump.
+option(SLIC3R_WITH_OCCT "Enable OCCT-backed STEP/SVG import and text shapes" ON)
+option(SLIC3R_WITH_OPENCV "Enable OpenCV-backed OBJ colour handling" ON)
+
 set(lisbslic3r_sources
     AABBMesh.cpp
     AABBMesh.hpp
@@ -497,7 +505,9 @@ set(CGAL_DO_NOT_WARN_ABOUT_CMAKE_BUILD_TYPE ON CACHE BOOL "" FORCE)
 cmake_policy(PUSH)
 cmake_policy(SET CMP0011 NEW)
 find_package(CGAL REQUIRED)
-find_package(OpenCV REQUIRED core)
+if (SLIC3R_WITH_OPENCV)
+    find_package(OpenCV REQUIRED core)
+endif ()
 cmake_policy(POP)
 
 add_library(libslic3r_cgal STATIC
@@ -537,14 +547,16 @@ target_compile_definitions(libslic3r PUBLIC -DUSE_TBB -DTBB_USE_CAPTURED_EXCEPTI
 target_include_directories(libslic3r PRIVATE ${CMAKE_CURRENT_SOURCE_DIR} PUBLIC ${CMAKE_CURRENT_BINARY_DIR})
 target_include_directories(libslic3r SYSTEM PUBLIC ${EXPAT_INCLUDE_DIRS})
 
+find_package(JPEG REQUIRED)
+find_package(draco REQUIRED)
+
+set(OCCT_LIBS "")
+if (SLIC3R_WITH_OCCT)
 # Find the OCCT and related libraries
 set(OpenCASCADE_DIR "${CMAKE_PREFIX_PATH}/lib/cmake/occt")
 find_package(OpenCASCADE REQUIRED)
 target_include_directories(libslic3r SYSTEM PUBLIC ${OpenCASCADE_INCLUDE_DIR})
 
-find_package(JPEG REQUIRED)
-find_package(draco REQUIRED)
-
 set(OCCT_LIBS
     TKXDESTEP
     TKSTEP
@@ -573,6 +585,16 @@ set(OCCT_LIBS
     TKMath
     TKernel
 )
+else ()
+    target_compile_definitions(libslic3r PUBLIC SLIC3R_NO_OCCT)
+endif ()
+
+set(OPENCV_LIBS "")
+if (SLIC3R_WITH_OPENCV)
+    set(OPENCV_LIBS opencv_world)
+else ()
+    target_compile_definitions(libslic3r PUBLIC SLIC3R_NO_OPENCV)
+endif ()
 
 target_link_libraries(libslic3r
     PUBLIC
@@ -581,7 +603,7 @@ target_link_libraries(libslic3r
         libigl
         libnest2d
         miniz
-        opencv_world
+        ${OPENCV_LIBS}
     PRIVATE
         ${CMAKE_DL_LIBS}
         ${EXPAT_LIBRARIES}
@@ -606,7 +628,7 @@ target_link_libraries(libslic3r
         OpenSSL::Crypto
     )
 
-if(NOT WIN32)
+if(NOT WIN32 AND SLIC3R_WITH_OCCT)
     # Link freetype for OCCT dependency (CAD operations need font rendering)
     target_link_libraries(libslic3r PRIVATE ${FREETYPE_LIBRARIES})
     if (NOT APPLE)
