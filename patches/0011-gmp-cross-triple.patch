# Cross-compile the autotools dependencies to another Apple platform.
#
# GMP derived --build from CMAKE_SYSTEM_PROCESSOR, which describes the target and
# is empty for iOS, producing a bare "-apple-darwin" triple. --build describes
# the machine doing the building, so it comes from the host processor.
#
# The host triple must also differ from the build triple: with both set to
# aarch64-apple-darwin, autoconf decides the build is native and tries to run its
# test binaries, which cannot work when targeting iOS and reports itself as
# "could not find a working compiler". config.sub in gmp-6.2.1 accepts
# -apple-ios, checked against the pinned tarball.
#
# iOS also needs -miphoneos-version-min and the iPhoneOS sysroot, and MPFR — which
# reuses GMP's flags and triple — must not pass a bare --host= from the Linux
# cross convention TOOLCHAIN_PREFIX, which is never set on Apple.
# A cross build also needs a compiler for the build machine itself: GMP compiles
# and runs generator programs during its own build, and CC carries an iOS
# sysroot, so configure stopped at "Cannot find a build system compiler".
#
diff --git a/deps/GMP/GMP.cmake b/deps/GMP/GMP.cmake
index b3ba1817..74e751fa 100644
--- a/deps/GMP/GMP.cmake
+++ b/deps/GMP/GMP.cmake
@@ -24,21 +24,44 @@ else ()
     set(_gmp_build_tgt "${CMAKE_SYSTEM_PROCESSOR}")
 
     if (APPLE)
-        if (${CMAKE_SYSTEM_PROCESSOR} MATCHES "arm")
+        # --build describes the machine doing the building, so it comes from the
+        # host processor. CMAKE_SYSTEM_PROCESSOR describes the target and is empty
+        # when that target is iOS, which produced a bare "-apple-darwin" triple and
+        # a config.sub failure before anything compiled.
+        set(_gmp_build_machine "${CMAKE_SYSTEM_PROCESSOR}")
+        if (NOT _gmp_build_machine)
+            set(_gmp_build_machine "${CMAKE_HOST_SYSTEM_PROCESSOR}")
+        endif ()
+        if (_gmp_build_machine MATCHES "arm")
             set(_gmp_build_arch aarch64)
         else ()
-            set(_gmp_build_arch ${CMAKE_SYSTEM_PROCESSOR})
+            set(_gmp_build_arch ${_gmp_build_machine})
         endif()
         if (IS_CROSS_COMPILE)
-            if (${CMAKE_OSX_ARCHITECTURES} MATCHES "arm")
+            if ("${CMAKE_OSX_ARCHITECTURES}" MATCHES "arm")
                 set(_gmp_host_arch aarch64)
                 set(_gmp_host_arch_flags "-arch arm64")
-            elseif (${CMAKE_OSX_ARCHITECTURES} MATCHES "x86_64")
+            elseif ("${CMAKE_OSX_ARCHITECTURES}" MATCHES "x86_64")
                 set(_gmp_host_arch x86_64)
                 set(_gmp_host_arch_flags "-arch x86_64")
             endif()
-            set(_gmp_ccflags "${_gmp_ccflags} ${_gmp_host_arch_flags} -mmacosx-version-min=${DEP_OSX_TARGET}")
-            set(_gmp_build_tgt --build=${_gmp_build_arch}-apple-darwin --host=${_gmp_host_arch}-apple-darwin)
+            if (CMAKE_SYSTEM_NAME STREQUAL "iOS")
+                # A different platform needs its own minimum-version flag and its
+                # own sysroot; -mmacosx-version-min is meaningless here.
+                set(_gmp_ccflags "${_gmp_ccflags} ${_gmp_host_arch_flags} -miphoneos-version-min=${CMAKE_OSX_DEPLOYMENT_TARGET} -isysroot ${CMAKE_OSX_SYSROOT}")
+            else ()
+                set(_gmp_ccflags "${_gmp_ccflags} ${_gmp_host_arch_flags} -mmacosx-version-min=${DEP_OSX_TARGET}")
+            endif ()
+            # The host triple must differ from the build triple or autoconf
+            # decides this is a native build and tries to run its test binaries,
+            # which fails with "could not find a working compiler". config.sub in
+            # gmp-6.2.1 accepts -apple-ios, so the platform makes them differ
+            # honestly rather than by fudging the architecture.
+            if (CMAKE_SYSTEM_NAME STREQUAL "iOS")
+                set(_gmp_build_tgt --build=${_gmp_build_arch}-apple-darwin --host=${_gmp_host_arch}-apple-ios)
+            else ()
+                set(_gmp_build_tgt --build=${_gmp_build_arch}-apple-darwin --host=${_gmp_host_arch}-apple-darwin)
+            endif ()
         else ()
             set(_gmp_ccflags "${_gmp_ccflags} -mmacosx-version-min=${DEP_OSX_TARGET}")
             set(_gmp_build_tgt "--build=${_gmp_build_arch}-apple-darwin")
@@ -59,13 +82,31 @@ else ()
         set(_cross_compile_arg --host=${TOOLCHAIN_PREFIX})
     endif ()
 
+    # A real cross build needs two compilers: CC for the target, and one that
+    # produces binaries the build machine can run — GMP builds and runs generator
+    # programs during its own build. CC carries an iOS sysroot, so configure's
+    # fallback of reusing it fails and it stops at "Cannot find a build system
+    # compiler".
+    #
+    # The macOS sysroot has to be named explicitly rather than left to the driver:
+    # an iOS build sets SDKROOT in the environment, which clang honours, so a bare
+    # clang here still produces iOS binaries and configure rejects it in turn with
+    # "Specified CC_FOR_BUILD doesn't seem to work". -isysroot outranks SDKROOT.
+    set(_gmp_build_cc "")
+    if (CMAKE_SYSTEM_NAME STREQUAL "iOS")
+        execute_process(COMMAND xcrun --sdk macosx --show-sdk-path
+                        OUTPUT_VARIABLE _macos_sdk
+                        OUTPUT_STRIP_TRAILING_WHITESPACE)
+        set(_gmp_build_cc "CC_FOR_BUILD=/usr/bin/clang -isysroot ${_macos_sdk}")
+    endif ()
+
     ExternalProject_Add(dep_GMP
         URL https://github.com/SoftFever/OrcaSlicer_deps/releases/download/gmp-6.2.1/gmp-6.2.1.tar.bz2
         URL_HASH SHA256=eae9326beb4158c386e39a356818031bd28f3124cf915f8c5b1dc4c7a36b4d7c
         DOWNLOAD_DIR ${DEP_DOWNLOAD_DIR}/GMP
         PATCH_COMMAND git apply ${GMP_DIRECTORY_FLAG} --verbose ${CMAKE_CURRENT_LIST_DIR}/0001-GMP_GCC15.patch
         BUILD_IN_SOURCE ON
-        CONFIGURE_COMMAND  env "CC=${CMAKE_C_COMPILER}" "CXX=${CMAKE_CXX_COMPILER}" "CFLAGS=${_gmp_ccflags}" "CXXFLAGS=${_gmp_ccflags}" "LDFLAGS=${CMAKE_EXE_LINKER_FLAGS}" ./configure ${_cross_compile_arg} --enable-shared=no --enable-cxx=yes --enable-static=yes "--prefix=${DESTDIR}" ${_gmp_build_tgt}
+        CONFIGURE_COMMAND  env ${_gmp_build_cc} "CC=${CMAKE_C_COMPILER}" "CXX=${CMAKE_CXX_COMPILER}" "CFLAGS=${_gmp_ccflags}" "CXXFLAGS=${_gmp_ccflags}" "LDFLAGS=${CMAKE_EXE_LINKER_FLAGS}" ./configure ${_cross_compile_arg} --enable-shared=no --enable-cxx=yes --enable-static=yes "--prefix=${DESTDIR}" ${_gmp_build_tgt}
         BUILD_COMMAND     make -j
         INSTALL_COMMAND   make install
     )
diff --git a/deps/MPFR/MPFR.cmake b/deps/MPFR/MPFR.cmake
index 755a7699..9df288f4 100644
--- a/deps/MPFR/MPFR.cmake
+++ b/deps/MPFR/MPFR.cmake
@@ -19,10 +19,13 @@ if (MSVC)
 else ()
 
     set(_cross_compile_arg "")
-    if (CMAKE_CROSSCOMPILING)
+    if (CMAKE_CROSSCOMPILING AND TOOLCHAIN_PREFIX)
         # TOOLCHAIN_PREFIX should be defined in the toolchain file
         set(_cross_compile_arg --host=${TOOLCHAIN_PREFIX})
     endif ()
+    # Apple cross builds are cross-compiling but have no toolchain prefix — the
+    # triple arrives through _gmp_build_tgt below — so without the guard above
+    # this passed a bare --host= to configure.
 
     ExternalProject_Add(dep_MPFR
         URL https://ftp.gnu.org/gnu/mpfr/mpfr-4.2.2.tar.bz2
